{
  "name": "jokkorm-web",
  "version": "0.1.0",
  "private": true,
  "description": "JokkoRM admin + operator UI. Next.js App Router.",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:lan": "next dev -p 3100 --experimental-https --experimental-https-key .certs/lan-key.pem --experimental-https-cert .certs/lan-cert.pem",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-zxing-wasm.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "5.62.7",
    "@types/three": "^0.169.0",
    "barcode-detector": "3.2.4",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "1.7.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "eslint": "9.17.0",
    "eslint-config-next": "15.1.6",
    "typescript": "5.7.2"
  }
}
